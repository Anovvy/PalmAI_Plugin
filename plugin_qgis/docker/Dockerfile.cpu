# PalmAI inference image - CPU
# Build (from the plugin_qgis directory):
#   docker build -f docker/Dockerfile.cpu -t ghcr.io/anovvy/palmai-core:cpu .
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel
RUN pip install torch==2.5.1 torchvision==0.20.1 --index-url https://download.pytorch.org/whl/cpu

COPY docker/requirements.lock /tmp/requirements.lock
RUN pip install -r /tmp/requirements.lock

WORKDIR /app
COPY palmai_core /app/palmai_core

# Models are mounted at /models, job data under /mnt/N (see backends/docker_backend.py)
ENTRYPOINT []
CMD ["python", "-m", "palmai_core.worker", "--check"]
